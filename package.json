{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx scripts/validate-vivi.ts && node --import tsx scripts/test-canonical-runtime.ts && node --import tsx scripts/test-experience-compiler.ts && node --import tsx scripts/test-openrouter-provider.ts && node --import tsx scripts/test-experience-v2.ts && node --import tsx scripts/test-v3-foundation.ts && node --import tsx scripts/test-v3-correction.ts && node --import tsx scripts/eval-experience-compiler.ts",
    "eval": "node --import tsx scripts/eval-experience-compiler.ts",
    "bench": "node --import tsx scripts/benchmark-experience-compiler.ts",
    "bench:openrouter": "node --import tsx scripts/openrouter-bakeoff.ts --configured --set corpus --runs 1 --out reports/data/bench-openrouter.json",
    "eval:openrouter": "node --import tsx scripts/openrouter-bakeoff.ts --configured --set all --runs 1 --out reports/data/eval-openrouter.json",
    "eval:models": "node --import tsx scripts/openrouter-bakeoff.ts --set all --runs 2 --out reports/data/openrouter-bakeoff.json --report reports/openrouter-model-bakeoff.md",
    "report:models": "node --import tsx scripts/openrouter-report.ts",
    "test:v2": "node --import tsx scripts/test-experience-v2.ts",
    "test:v3-unit": "node --import tsx scripts/test-v3-foundation.ts",
    "test:v3-browser": "node --import tsx scripts/test-v3-browser.ts",
    "test:v3-foundation": "npm run test:v3-unit && npm run test:v3-browser",
    "test:v3-correction": "node --import tsx scripts/test-v3-correction.ts",
    "trace:v3-correction": "node --import tsx scripts/trace-v3-correction.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
